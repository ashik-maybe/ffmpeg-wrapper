{
  "rules": [
    {
      "code": "E_CONFLICT",
      "severity": "error",
      "message": "crf conflicts with b:v for the same output",
      "fix": "Use only one rate control mode: drop -crf or -b:v",
      "requireAny": ["crf"],
      "forbidAny": ["b:v"]
    },
    {
      "code": "E_CONFLICT",
      "severity": "error",
      "message": "-c copy conflicts with filters",
      "fix": "Drop -vf, -filter_complex or -af, or drop -c copy",
      "requireAny": ["c"],
      "valueConstraint": { "oneOf": ["copy"] },
      "forbidAny": ["vf", "filter_complex", "af"]
    },
    {
      "code": "E_INVALID_CHOICE",
      "severity": "error",
      "message": "atempo must be between 0.5 and 100",
      "fix": "Set the atempo value in the 0.5-100 range",
      "requireAny": ["atempo"],
      "valueConstraint": { "min": 0.5, "max": 100 }
    },
    {
      "code": "E_UNVERIFIED",
      "severity": "info",
      "message": "-ss before -i is an input seek; -to then sets the output end time",
      "fix": "Use -t for a duration, or place -ss after -i for an output seek",
      "order": { "flag": "ss", "before": "i" }
    },
    {
      "code": "E_CONFLICT",
      "severity": "warning",
      "message": "-vf and -filter_complex are mutually exclusive",
      "fix": "Use only one of -vf or -filter_complex",
      "requireAny": ["vf"],
      "forbidAny": ["filter_complex"]
    },
    {
      "code": "E_CONFLICT",
      "severity": "error",
      "message": "-movflags +faststart is only valid for mp4, mov, or m4a output",
      "fix": "Use an mp4, mov, or m4a output, or remove +faststart",
      "requireAny": ["movflags"],
      "valueConstraint": { "includes": "faststart" },
      "outputExtensions": ["mp4", "mov", "m4a"]
    },
    {
      "code": "E_CONFLICT",
      "severity": "error",
      "message": "-map_metadata -1 conflicts with -map_metadata 0",
      "fix": "Use only one of -map_metadata -1 or -map_metadata 0",
      "requireAny": ["map_metadata"],
      "valueConstraint": { "oneOf": ["-1"] },
      "forbidFlagValues": [{ "flag": "map_metadata", "values": ["0"] }]
    },
    {
      "code": "E_CONFLICT",
      "severity": "error",
      "message": "-force_key_frames conflicts with -c copy",
      "fix": "Drop -force_key_frames, or re-encode instead of -c copy",
      "requireAny": ["c"],
      "valueConstraint": { "oneOf": ["copy"] },
      "forbidAny": ["force_key_frames"]
    },
    {
      "code": "E_CONFLICT",
      "severity": "warning",
      "message": "-copyts with -avoid_negative_ts may produce unexpected timestamps",
      "fix": "Drop -avoid_negative_ts, or drop -copyts",
      "requireAny": ["copyts"],
      "forbidAny": ["avoid_negative_ts"]
    },
    {
      "code": "E_MISSING_VALUE",
      "severity": "error",
      "message": "-filter_complex_script requires a real file value",
      "fix": "Provide a path to a filter script file",
      "requireAny": ["filter_complex_script"],
      "valueConstraint": { "realFile": true }
    }
  ]
}
