{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool spec",
  "description": "Every option of one tool version, in the shape of src/core/types.ts ToolSpec.",
  "type": "object",
  "required": ["tool", "version", "options"],
  "properties": {
    "tool": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/option" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "option": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["flag", "option", "value"] },
        "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "metavar": { "type": "string" },
        "choices": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "default": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
