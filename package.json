{
  "name": "ffmpeg-wrapper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "design:lint": "node scripts/design-lint.mjs",
    "spec:check": "node scripts/spec-check.mjs",
    "readme:check": "node scripts/readme-check.mjs",
    "ci": "bun run lint && bun run format:check && bun run typecheck && bun run design:lint && bun run spec:check && bun run readme:check && bun run test && bun run tui:test",
    "tui": "bun bin/ffmpeg-tui.ts",
    "tui:build": "bun build bin/ffmpeg-tui.ts --compile --target bun-linux-x64 --outfile dist/ffmpeg-tui-linux-x64",
    "tui:arm": "bun build bin/ffmpeg-tui.ts --compile --target bun-linux-arm64 --outfile dist/ffmpeg-tui-linux-arm64",
    "tui:test": "vitest run tests/tui"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "react-devtools-core": "^6.1.2",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
